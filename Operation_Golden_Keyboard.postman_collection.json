              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var response = pm.response.json();\r\nif (response.access) {\r\n    pm.environment.set(\"access_token\", response.access);\r\n    pm.environment.set(\"refresh_token\", response.refresh);\r\n}"
